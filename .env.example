# LangSmith tracing — the demo is much better with this on.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=website-builder-demo
LANGSMITH_API_KEY=

# Do NOT put ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY here.
# Those come from the ambient gateway environment; plain load_dotenv() never
# overrides an already-set variable, so keeping them out of this file is what
# lets the gateway win.
